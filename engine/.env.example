# --- Whisper model --------------------------------------------------------
ENGINE_MODEL=onnx-community/whisper-large-v3-turbo
ENGINE_TRANSCRIBE_MODE=chunked
ENGINE_DEVICE=cpu
ENGINE_DTYPE=q8

# Toplantı "Yabancı dil" olarak kaydedildiğinde kullanılan model. Döküm yine Türkçe
# üretilir — değişen tek şey hangi ağırlıkların çözümlediğidir. turbo'nun distile 4
# katmanlı decoder'ı zorlanan dil sesle uyuşmadığında tekrar döngüsüne çöküyor; medium'un
# tam decoder'ı kaba ama gerçek bir Türkçe karşılık üretiyor (bkz.
# docs/multilingual-transcription.md). Türkçe'de medium turbo'dan geride olduğu
# için varsayılan değil, yalnız bu yol için var. Quantized-only yayınlandığından hep q8.
ENGINE_MODEL_FOREIGN=onnx-community/whisper-medium-ONNX

# --- Analysis: model seçimi (YALNIZ GELİŞTİRİCİ CLI ARAÇLARI) --------------
#
# ⚠️ Masaüstü uygulaması bu dört değişkeni OKUMAZ. Uygulamada analiz modeli Ayarlar ›
# Analiz Modeli ekranından set edilir; ayar Electron userData altındaki
# model-config.json içinde durur ve açılışta engine'e kurulur (configureLlm). Kurulu bir
# yapılandırma varken aşağıdakiler tamamen yok sayılır — yarısı uygulanmaz, hiçbiri
# uygulanmaz.
#
# Buradaki değerler yalnız `npm run bench` ve `npm run test-run -w engine` gibi CLI
# araçları içindir: onlar bir uygulama başlatmadığı için hiçbir yapılandırma kurmaz ve
# .env'e düşerler. Hiçbiri set edilmezse ilk preset (yerel Ollama) kullanılır.

ENGINE_LLM_PROVIDER=ollama
ENGINE_LLM_MODEL=qwen3.6:35b-a3b
ENGINE_LLM_URL=http://localhost:11434
ENGINE_LLM_API_KEY=

# -- Bench için sağlayıcı örnekleri
# OpenAI (ve OpenAI-uyumlu her sunucu: OpenRouter, Groq, vLLM, LM Studio — URL'i çevirin)
#   ENGINE_LLM_PROVIDER=openai
#   ENGINE_LLM_MODEL=gpt-5
#   ENGINE_LLM_URL=https://api.openai.com/v1
#   ENGINE_LLM_API_KEY=sk-...

# Anthropic (Claude):
#   ENGINE_LLM_PROVIDER=anthropic
#   ENGINE_LLM_MODEL=claude-sonnet-5
#   ENGINE_LLM_URL=https://api.anthropic.com
#   ENGINE_LLM_API_KEY=sk-ant-...

# Google Gemini (AI Studio).
#   ENGINE_LLM_PROVIDER=gemini
#   ENGINE_LLM_MODEL=gemini-2.5-flash
#   ENGINE_LLM_URL=https://generativelanguage.googleapis.com
#   ENGINE_LLM_API_KEY=...

# Yanıt üst sınırı. Anthropic bunu zorunlu tutar; diğerlerinde de tavan görevi görür.
ENGINE_LLM_MAX_TOKENS=4096
# Yalnız openai sağlayıcısı için: schema | object. json_schema'yı reddeden
# OpenAI-uyumlu sunucularda `object`'e düşür.
ENGINE_LLM_JSON_MODE=schema

# --- Analysis: parçalama ve zaman aşımı ------------------------------------
# ENGINE_LLM_NUM_CTX yalnız Ollama'ya gönderilir, ama HER sağlayıcıda anlamlıdır:
# tek geçiş mi map/reduce mi yapılacağını belirleyen parçalama bütçesidir. Bulut
# modellerinde modelin gerçek bağlam penceresine ayarla.
ENGINE_LLM_TEMPERATURE=0
ENGINE_LLM_NUM_CTX=8192
ENGINE_LLM_TIMEOUT_MS=120000
ENGINE_LLM_MAX_RETRIES=2
ENGINE_LLM_MAP_CONCURRENCY=4
ENGINE_LLM_CHUNK_TOKENS=2200
ENGINE_LLM_CHUNK_OVERLAP_TOKENS=180
ENGINE_LLM_CHARS_PER_TOKEN=3.5
